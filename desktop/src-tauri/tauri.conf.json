{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Arca",
  "version": "2.52.0",
  "identifier": "com.scoheart.arca",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bash scripts/prepare-release.sh",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Arca",
        "width": 1200,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "visible": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/.arca/assets/mcp-icons/**",
          "$HOME/.mux/assets/mcp-icons/**"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Scoheart/arca/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY5MDEzRENBRDAyRTM5RjUKUldUMU9TN1F5ajBCK1VXdElRYzcxb0ZrR3ZkVWN6VTNBUCt0T2NubEoxdW1UaWt1aFR3WFBraHUK"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "macOS": {
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist",
      "infoPlist": "Info.plist"
    },
    "externalBin": [
      "binaries/arca"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Agent Asset Manager",
    "longDescription": "Manage Models, MCP tools, and Skills as central assets for your AI Agents."
  }
}
