[
  {
    "agent_id": "cursor",
    "docs_url": "https://cursor.com/docs/plugins",
    "manifest_paths": [
      ".cursor-plugin/plugin.json",
      ".claude-plugin/plugin.json",
      "plugin.json"
    ],
    "default_mcp_files": [
      ".mcp.json",
      "mcp.json"
    ],
    "mcp_id_prefix": "plugin-",
    "roots": [
      {
        "path": "~/.cursor/plugins/cache",
        "layout": "marketplace_cache",
        "presence": "cache_only",
        "complete_marker": ".cache-complete"
      },
      {
        "path": "~/.cursor/plugins/local",
        "layout": "flat",
        "presence": "local"
      }
    ],
    "adapter": "cursor"
  },
  {
    "agent_id": "codex",
    "adapter": "codex",
    "docs_url": "https://developers.openai.com/plugins",
    "manifest_paths": [
      ".codex-plugin/plugin.json",
      ".claude-plugin/plugin.json",
      ".cursor-plugin/plugin.json"
    ],
    "default_mcp_files": [
      ".mcp.json"
    ],
    "mcp_id_prefix": "",
    "roots": [
      {
        "path": "~/.codex/plugins/cache",
        "layout": "codex_active_cache",
        "presence": "installed"
      }
    ]
  },
  {
    "agent_id": "claude-code",
    "adapter": "claude",
    "docs_url": "https://code.claude.com/docs/en/plugins-reference",
    "manifest_paths": [
      ".claude-plugin/plugin.json"
    ],
    "default_mcp_files": [
      ".mcp.json"
    ],
    "mcp_id_prefix": "plugin:",
    "roots": [
      {
        "path": "~/.claude/plugins",
        "layout": "claude_installed_registry",
        "presence": "installed"
      }
    ]
  },
  {
    "agent_id": "gemini",
    "adapter": "gemini",
    "docs_url": "https://geminicli.com/docs/extensions/reference/",
    "manifest_paths": [
      "gemini-extension.json"
    ],
    "default_mcp_files": [],
    "mcp_id_prefix": "",
    "roots": [
      {
        "path": "~/.gemini/extensions",
        "layout": "gemini_extensions",
        "presence": "installed"
      }
    ]
  },
  {
    "agent_id": "opencode",
    "adapter": "opencode",
    "docs_url": "https://opencode.ai/docs/plugins/",
    "manifest_paths": [
      "package.json"
    ],
    "default_mcp_files": [],
    "mcp_id_prefix": "",
    "roots": [
      {
        "path": "~/.config/opencode",
        "layout": "opencode_global",
        "presence": "declared"
      },
      {
        "path": "~/.opencode/bin/opencode",
        "layout": "opencode_bundled",
        "presence": "bundled"
      }
    ]
  },
  {
    "agent_id": "codex-desktop",
    "adapter": "codex",
    "docs_url": "https://developers.openai.com/plugins",
    "manifest_paths": [
      ".codex-plugin/plugin.json",
      ".claude-plugin/plugin.json",
      ".cursor-plugin/plugin.json"
    ],
    "default_mcp_files": [
      ".mcp.json"
    ],
    "mcp_id_prefix": "",
    "roots": [
      {
        "path": "~/.codex/plugins/cache",
        "layout": "codex_active_cache",
        "presence": "installed"
      },
      {
        "path": "/Applications/ChatGPT.app/Contents/Resources",
        "layout": "codex_bundled_resources",
        "presence": "bundled"
      },
      {
        "path": "~/Applications/ChatGPT.app/Contents/Resources",
        "layout": "codex_bundled_resources",
        "presence": "bundled"
      }
    ]
  },
  {
    "agent_id": "codex-ide",
    "adapter": "codex",
    "docs_url": "https://developers.openai.com/plugins",
    "manifest_paths": [
      ".codex-plugin/plugin.json",
      ".claude-plugin/plugin.json",
      ".cursor-plugin/plugin.json"
    ],
    "default_mcp_files": [
      ".mcp.json"
    ],
    "mcp_id_prefix": "",
    "roots": [
      {
        "path": "~/.codex/plugins/cache",
        "layout": "codex_active_cache",
        "presence": "installed"
      }
    ]
  }
]
